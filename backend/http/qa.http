Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "answerId": {{answerId}}
}

> {%
    client.test("采纳成功（204）", function () {
        client.assert(response.status === 204, "采纳失败：" + response.status + "，响应：" + response.body);
    });
%}


### 22. 详情复核（问题侧：采纳标记、回答数；回答侧：认证标记、得分、评论数）
GET http://localhost:8080/api/v1/questions/{{questionId}}
Accept: application/json

> {%
    client.test("详情复核通过", function () {
        client.assert(response.status === 200, "详情失败：" + response.status);
        client.assert(response.body.acceptedAnswerId === client.global.get("answerId"), "采纳答案 id 不一致");
        client.assert(response.body.answerCount === 1, "回答数应为 1");
        const answer = response.body.answers[0];
        client.assert(answer.accepted === true, "回答应标记为已采纳");
        client.assert(answer.endorsedBy !== null, "回答应有教师认证人");
        client.assert(answer.score === 1, "回答得分应为 1");
        client.assert(answer.comments !== null && answer.comments.length === 2, "回答下应有 1 条评论 + 1 条二级回复");
    });
%}


