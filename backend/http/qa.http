### 26. 反例：已采纳回答不允许作者自行删除（QA-0206，防“先骗采纳再删除”）
DELETE http://localhost:8080/api/v1/answers/{{answerId}}
X-XSRF-TOKEN: {{xsrf}}

> {%
    client.test("作者删不了已采纳回答（403）", function () {
        client.assert(response.status === 403, "应返回 403，实际：" + response.status + "，响应：" + response.body);
        client.assert(response.body.code === "QA-0206", "错误码应为 QA-0206，实际：" + response.body.code);
    });
%}


